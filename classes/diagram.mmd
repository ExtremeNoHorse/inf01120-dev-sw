classDiagram
    App *-- Menu
    Menu *-- MusicManager
    Menu *-- Player
    Menu *-- InputHandler

    InputHandler *-- InputValidator
    InputValidator *-- ValidationRule

    MusicManager *-- MusicRepository
    MusicRepository o-- Music
    Music *-- FileHandler

    Player *-- Interpreter
    Interpreter *-- JFuguePlayer
    Interpreter *-- DomainMapper
    Interpreter *-- PlayerConfig
    PlayerConfig *-- PlaybackParameters

    DomainMapper *-- Command
    Command <|-- Note
    Command <|-- ConfigUpdate

    class App {
        -Menu menu
        +void run()
    }

    class Menu {
        -MusicManager MusicManager
        -PlaybackService playbackService
        -InputHandler inputHandler
        +void show()
    }

    class InputHandler {
        -InputValidator validator
        +String handle()
    }

    class InputValidator {
        -List~ValidationRule~ rules
        +void validate(String input)
    }

    class ValidationRule {
        +void validate(String input)
    }

    class MusicManager {
        -MusicRepository repository
        +Music createMusic(String name)
        +void deleteMusic(int id)
        +Music openMusic(int id)
    }

    class MusicRepository {
        -List~Music~ Musics
        +Music getById(int id)
        +Music create(String name)
        +void deleteById(int id)
        +void save(Music s)
    }

    class Music {
        -int id
        -String name
        -FileHandler fileHandler
        +int getId()
        +String getName()
        +void setName(String name)
        +boolean hasRecording()
    }

    class FileHandler {
        -String musicFilePath
        -String recordingFilePath
        -void writeFile()
        -void saveFile()
        -void deleteFile()
    }

    class Player {
        -Interpreter interpreter
        +void play(Music music)
        +void pause(Music music)
        +void configure(PlayerConfig config)
    }

    class Interpreter {
        -DomainMapper mapper
        -PlayerConfig playerConfig
        -JFuguePlayer player
        -String music
        +String interpret(String text)
    }

    class DomainMapper {
        +Command toDomain(char c)
    }

    class Command {
        <<Interface>>
        +void execute()
    }

    class Note {
        -char cmd

        +void execute()
    }

    class ConfigUpdate {
        -char cmd
        +void execute()
    }

    class PlayerConfig {
        -int instrument
        -int octave
        -int volume
        -int bpm
        -PlaybackParameters params
        -StringBuilder output
        +void reset()
        +void setInstrument(int midi)
        +void changeOctave(int delta)
        +void doubleVolume()
        +String getPattern()
    }

    class PlaybackParameters {
        -int defaultBpm
        -int defaultInstrument
        -int defaultOctave
        -int defaultVolume
        -int maxVolume
    }

    class JFuguePlayer {
        +void play(String pattern)
    }

