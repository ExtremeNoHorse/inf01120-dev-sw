---
config:
  theme: default
---
%% TTM - Diagrama refatorado (Fase 1)
%%
%% Mudancas vs original (motivadas pelos resumos R01/R02/R03/Cap5-OOSC):
%%   1. Menu vira App (unica classe UI/composition root; CLI hoje, GUI depois).
%%   2. Interpreter dividido: Interpreter (char->pattern) + Player (executa).
%%   3. AudioEngine interface esconde JFugue (info hiding R02) e expoe exportMidi.
%%   4. MusicRepository vira interface; FileMusicRepository usa java.nio direto.
%%   5. Command.execute(PlayerConfig) - sem acoplamento reverso.
%%   6. TtmException + ErrorCode substituem varios exception types.
%%   7. PlaybackListener = Consumer<Integer> do JDK (sem interface propria).
%%   8. PlaybackParameters vira constantes em PlayerConfig.
%%   9. Terminologia: Music (mockup) substitui Session.

classDiagram
    App *-- InputValidator
    App *-- MusicRepository
    App *-- Player

    MusicRepository <|.. FileMusicRepository
    MusicRepository o-- Music

    Player *-- Interpreter
    Player *-- AudioEngine
    JFuguePlayer *-- ManagedPlayer
    AudioEngine <|.. JFuguePlayer

    Interpreter *-- DomainMapper
    Interpreter *-- PlayerConfig

    DomainMapper *-- Command
    Command <|.. Note
    Command <|.. ConfigUpdate

    TtmException *-- ErrorCode

    class App {
        -InputValidator validator
        -MusicRepository repository
        -Player player
        +static void main(String[] args)
        +int run(String[] args)
    }

    class InputValidator {
        -List~Predicate~String~~ rules
        +void validate(String input)
    }

    class MusicRepository {
        <<interface>>
        +Music newMusic()
        +Music save(String Name)
        +Music getById(String id)
        +Music getByPath(Path path)
        +List~Music~ findAll()
        +void deleteById(String id)
    }

    class FileMusicRepository {
        -Path baseDir
        +Music newMusic()
        +Music save(String Name)
        +Music getById(String id)
        +Music getByPath(Path path)
        +List~Music~ findAll()
        +void deleteById(String id)
    }

    class Music {
        -String id
        -String name
        -String content
        +String getId()
        +String getName()
        +void setName(String name)
        +String getContent()
        +void setContent(String content)
        +boolean hasRecording()
    }

    class Player {
        -Interpreter interpreter
        -AudioEngine audioEngine
        -PlayerConfig playerConfig
        %% Caso o Pimenta comente sobre eventos
        %% -Consumer~Integer~ onCharPlayed
        +void play(Music music)
        +void pause()
        +void resume()
        +void stop()
        +void configure(PlayerConfig config)
        +Path export(Music music, Path targetPath)
        %% +void onCharPlayed(Consumer~Integer~ listener)
    }

    class Interpreter {
        -DomainMapper mapper
        -PlayerConfig playerConfig
        -StringBuilder pattern
        +String interpret(String text)
    }

    class DomainMapper {
        -Map~String,Command~ table
        -List~String~ playedCommands
        +Command toDomain(String c)
        +boolean supports(String c)
    }

    class Command {
        <<interface>>
        +void execute(PlayerConfig config)
    }

    class Note {
        -String cmd
        +void execute(PlayerConfig config)
    }

    class ConfigUpdate {
        -String cmd
        +void execute(PlayerConfig config)
    }

    class PlayerConfig {
        -int instrument
        -int octave
        -int volume
        -int bpm
        +void reset()
        +void setInstrument(int midi)
        +void setOctave(int octave)
        +void setBpm(int bpm)
        +void setVolume(int vol)
        +int getInstrument()
        +int getOctave()
        +int getVolume()
        +int getBpm()
    }
    class AudioEngine {
        <<interface>>
        +void play(String pattern)
        +void pause()
        +void resume()
        +void stop()
        +void seek(int index)
    }

    class JFuguePlayer {
        +void play(String pattern)
        +ManagedPlayer getManagedPlayer()
    }

    class ManagedPlayer {
        +void pause()
        +void resume()
        +void stop()
        +void seek(long tick)
    }

    class TtmException {
        -ErrorCode code
        -String message
        +ErrorCode getCode()
    }

    class ErrorCode {
        <<enumeration>>
        INVALID_INPUT
        INVALID_CHARACTER
        MUSIC_NOT_FOUND
        INVALID_PLAYBACK_CONFIG
        PERSISTENCE_FAILURE
        AUDIO_ENGINE_FAILURE
    }
