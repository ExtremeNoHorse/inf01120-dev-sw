%% TTM - Diagrama de Classes
%% Classes do projeto e dependencias JFugue usadas pelo adaptador de audio.

classDiagram
    App ..> InputValidator : cria
    App ..> FileMusicRepository : cria
    App ..> JFuguePlayer : cria
    App ..> DomainMapper : cria
    App ..> PlayerConfig : cria
    App ..> Interpreter : cria
    App ..> Player : cria
    App ..> MusicLibrary : cria
    App ..> MainPresenter : cria
    App ..> MainWindow : abre

    MainView <|.. MainWindow
    MainWindow ..> MainPresenter : eventos
    MainWindow *-- MusicListPanel
    MainWindow *-- EditorPanel
    MainWindow *-- PlaybackBar
    MainWindow ..> StartPanel : cria
    MainWindow ..> FileDialogs
    MainWindow ..> Theme
    MusicListPanel ..> MainPresenter : eventos
    EditorPanel ..> MainPresenter : eventos
    PlaybackBar ..> MainPresenter : eventos
    StartPanel ..> MainPresenter : eventos
    MusicListPanel ..> Music
    MusicListPanel ..> Theme
    EditorPanel ..> Theme
    PlaybackBar ..> Theme
    PlaybackBar ..> PlayerConfig
    StartPanel ..> Theme

    MainPresenter --> MainView
    MainPresenter --> MusicLibrary
    MainPresenter --> Player
    MainPresenter --> InputValidator
    MainPresenter --> Music : current
    MainPresenter --> Timeline
    MainPresenter --> PlaybackState
    MainPresenter ..> PlayerConfig
    MainPresenter ..> TtmException
    MusicLibrary --> MusicRepository
    MusicLibrary ..> Music
    MusicLibrary ..> TtmException
    MusicRepository <|.. FileMusicRepository
    MusicRepository ..> Music
    FileMusicRepository ..> TtmException
    InputValidator ..> TtmException

    Player --> Interpreter
    Player --> AudioEngine
    Player ..> Music
    Player ..> PlayerConfig
    Player ..> Timeline
    Player ..> TtmException
    AudioEngine <|.. JFuguePlayer
    JFuguePlayer --> ManagedPlayer
    JFuguePlayer ..> JFugueLibraryPlayer
    JFuguePlayer ..> TtmException
    JFugueLibraryPlayer --> ManagedPlayer

    Interpreter --> DomainMapper
    Interpreter --> PlayerConfig
    Interpreter ..> Timeline : cria
    Interpreter *-- TimelineEvent : events
    Interpreter ..> NoteMatch
    Interpreter ..> Command
    Interpreter ..> SoundToken
    Interpreter ..> JFugueTokenFactory
    Interpreter ..> TtmException
    NoteMatch --> SoundToken
    Timeline *-- TimelineEvent
    DomainMapper --> Command : table
    DomainMapper ..> Note : cria
    DomainMapper ..> ConfigUpdate : cria
    DomainMapper ..> MusicalDuration
    DomainMapper ..> Instrument
    DomainMapper ..> PlayerConfig
    DomainMapper ..> JFugueTokenFactory
    Command <|.. Note
    Command <|.. ConfigUpdate
    Command ..> PlayerConfig
    Command ..> SoundToken
    Note --> MusicalDuration
    Note ..> JFugueTokenFactory
    SoundToken --> MusicalDuration
    SoundToken ..> JFugueTokenFactory
    PlayerConfig ..> Voice
    Voice --> Instrument

    TtmException --> ErrorCode

    class App {
        -App()
        ~void main()$
    }

