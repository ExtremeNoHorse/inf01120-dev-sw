---
config:
  theme: default
---
%% TTM - Diagrama de Classes Atualizado (Fase 2)
%%
%% Evolucoes da Fase 2 incorporadas:
%%   1. Suporte a polifonia (linhas como vozes V0, V1, V2...) com ciclo de parâmetros base a cada quatro vozes.
%%   2. MusicalDuration enum para representacao das 7 figuras de duracao (semibreve a semifusa).
%%   3. Note evoluida com suporte a acidentes (#, b) e duracoes explicitas.
%%   4. DomainMapper com fabrica createDefault() e suporte a tokens estruturados de nota.
%%   5. MusicRepository com assinatura correta save(Music music).
%%   6. AudioEngine + JFuguePlayer com exportacao de arquivo MIDI pelo Player.
%%   7. Tratamento centralizado de erros via TtmException e ErrorCode.
%%   8. Interface grafica Swing em MVP: MainWindow -> MainPresenter -> MusicLibrary / Player.

classDiagram
    App ..> MainPresenter : cria
    MainView <|.. MainWindow
    MainWindow ..> MainPresenter : eventos
    MainPresenter --> MainView
    MainPresenter --> MusicLibrary
    MainPresenter --> Player
    MainPresenter --> InputValidator
    MainPresenter ..> Timeline
    MusicLibrary --> MusicRepository

    App *-- InputValidator
    App *-- MusicRepository
    App *-- Player

    MusicRepository <|.. FileMusicRepository
    MusicRepository o-- Music

    Player *-- Interpreter
    Interpreter ..> Timeline : cria
    Player *-- AudioEngine
    JFuguePlayer *-- ManagedPlayer
    AudioEngine <|.. JFuguePlayer

    Interpreter *-- DomainMapper
    Interpreter *-- PlayerConfig

    DomainMapper *-- Command
    DomainMapper ..> MusicalDuration
    Command <|.. Note
    Command <|.. ConfigUpdate
    Note o-- MusicalDuration

    TtmException *-- ErrorCode

    class App {
        -InputValidator validator
        -MusicRepository repository
        -Player player
        +App()
        +App(InputValidator validator, MusicRepository repository, Player player)
        +MainPresenter createPresenter()
        ~static void main(String[] args)
        +int run(String[] args)
    }

    class InputValidator {
        -List~Predicate~String~~ rules
        +InputValidator()
        +InputValidator(List~Predicate~String~~ rules)
        +void addRule(Predicate~String~ rule)
        +void validate(String input)
    }

    class MusicRepository {
        <<interface>>
        +Music newMusic()
        +Music save(Music music)
        +Music saveAndOverwriteSource(Music music)
        +Music getById(String id)
        +Music getByPath(Path path)
        +List~Music~ findAll()
        +void deleteById(String id)
    }

    class FileMusicRepository {
        -Path baseDir
        +FileMusicRepository(String directoryPath)
        +Music newMusic()
        +Music save(Music music)
        +Music saveAndOverwriteSource(Music music)
        +Music getById(String id)
        +Music getByPath(Path path)
        +List~Music~ findAll()
        +void deleteById(String id)
    }

    class Music {
        -String id
        -String name
        -String content
        -Path sourcePath
        -boolean hasRecording
        +Music()
        +Music(String id, String name, String content)
        +String getId()
        +void setId(String id)
        +String getName()
        +void setName(String name)
        +String getContent()
        +void setContent(String content)
        +Path getSourcePath()
        +void setSourcePath(Path sourcePath)
        +boolean hasRecording()
        +void markAsRecorded()
        +boolean equals(Object obj)
        +int hashCode()
    }

    class Player {
        -Interpreter interpreter
        -AudioEngine audioEngine
        +Player(Interpreter interpreter, AudioEngine audioEngine)
        +void play(Music music)
        +void pause()
        +void resume()
        +void stop()
        +void configure(PlayerConfig config)
        +void seek(int tick)
        +Timeline timeline(String content)
        +long getTickPosition()
        +long getTickLength()
        +boolean isActive()
        +Path export(Music music, Path targetPath)
        +PlayerConfig getPlayerConfig()
    }

    class Interpreter {
        -DomainMapper mapper
        -PlayerConfig playerConfig
        -StringBuilder pattern
        +Interpreter()
        +Interpreter(DomainMapper mapper, PlayerConfig playerConfig)
        +void configure(PlayerConfig config)
        +PlayerConfig getPlayerConfig()
        +String interpret(String text)
        +Timeline timeline(String text)
    }

    class DomainMapper {
        -Map~String,Command~ table
        +DomainMapper(Map~String,Command~ table)
        +static DomainMapper createDefault()
        +Command toDomain(String c)
        +boolean supports(String c)
    }

    class Command {
        <<interface>>
        +String execute(PlayerConfig config)
    }

    class Note {
        -static String VOLUME_INTENSITY_SEPARATOR
        -String cmd
        -MusicalDuration duration
        +Note(String cmd)
        +Note(String cmd, MusicalDuration duration)
        +String cmd()
        +MusicalDuration duration()
        +String execute(PlayerConfig config)
        -static String buildJfugueToken(String jfugueNote, MusicalDuration duration, PlayerConfig config)
    }

    class MusicalDuration {
        <<enumeration>>
        WHOLE_NOTE
        HALF_NOTE
        QUARTER_NOTE
        EIGHTH_NOTE
        SIXTEENTH_NOTE
        THIRTY_SECOND
        SIXTY_FOURTH
        -int id
        -String jfugueToken
        +int getId()
        +String getJfugueToken()
        +double getBeats()
        +static MusicalDuration fromJfugueToken(String jfugueToken)
        +static MusicalDuration fromId(int id)
    }

    class ConfigUpdate {
        -Function~PlayerConfig, String~ updateAction
        +ConfigUpdate(Function~PlayerConfig,String~ updateAction)
        +String execute(PlayerConfig config)
    }

    class PlayerConfig {
        -int instrument
        -int octave
        -int volume
        -int bpm
        -int baseOctave
        -int baseVolume
        -int baseInstrument
        +PlayerConfig(int instrument, int octave, int volume, int bpm)
        +PlayerConfig(PlayerConfig source)
        +static PlayerConfig forVoice(int voiceIndex, int bpm)
        +static Map~Integer,String~ getGeneralMidiInstruments()
        +int getInstrument()
        +void setInstrument(int instrument)
        +int getOctave()
        +void setOctave(int octave)
        +int getVolume()
        +void setVolume(int volume)
        +int getBpm()
        +void setBpm(int bpm)
        +int getBaseOctave()
        +int getBaseVolume()
        +int getBaseInstrument()
        +void increaseOctaveRelative()
        +void decreaseOctaveRelative()
        +void doubleVolume()
        +void increaseBpm(int delta)
        +void decreaseBpm(int delta)
    }

    class AudioEngine {
        <<interface>>
        +void play(String pattern)
        +void pause()
        +void resume()
        +void stop()
        +void seek(int index)
        +long getTickPosition()
        +long getTickLength()
        +boolean isActive()
    }

    class MusicLibrary {
        -MusicRepository repository
        +MusicLibrary(MusicRepository repository)
        +List~Music~ listAll()
        +Music create(String name)
        +Music importFile(Path source)
        +Music saveContent(Music music, String content)
        +Music rename(Music music, String newName)
        +void delete(Music music)
    }

    class MainView {
        <<interface>>
        +void showMusics(List~Music~ musics, Music selected)
        +void showStartScreen()
        +void showEditor(Music music)
        +String editorText()
        +void showSettings(int octave, int bpm, int volume)
        +void showPlayButton()
        +void showPauseButton()
        +void enableEditorEditing()
        +void disableEditorEditing()
        +void showProgress(int permille)
        +void highlight(List~Integer~ offsets)
        +void showError(String message)
        +void showInfo(String message)
        +Optional~String~ askText(String message, String initialValue)
        +boolean confirm(String message)
        +Optional~Path~ chooseTextFile()
        +Optional~Path~ chooseExportFile(String suggestedName)
    }

    class MainPresenter {
        -MusicLibrary library
        -Player player
        -InputValidator validator
        -Music current
        +MainPresenter(MusicLibrary library, Player player, InputValidator validator)
        +void attach(MainView view)
        +void onNewMusic()
        +void onTypeText()
        +void onUpload()
        +void onSelect(Music music)
        +void onPlayPause()
        +void onStop()
        +void onRestart()
        +void onNext()
        +void onSeek(int permille)
        +void onOctaveChange(int delta)
        +void onBpmChange(int steps)
        +void onVolumeChange(int volume)
        +void onSave()
        +void onRename(Music music)
        +void onDelete(Music music)
        +void onExport(Music music)
        +void onTick()
        +void onClose()
    }

    class MainWindow {
        -JFrame frame
        +static void open(MainPresenter presenter)
    }

    class Timeline {
        -List~List~Event~~ voices
        -double length
        +Timeline(List~List~Event~~ voices)
        +double length()
        +List~Integer~ offsetsAt(double fraction)
    }

    class TimelineEvent["Timeline.Event"] {
        +int offset()
        +double start()
        +double end()
    }

    Timeline *-- TimelineEvent

    class JFuguePlayer {
        -ManagedPlayer managedPlayer
        +JFuguePlayer()
        +JFuguePlayer(Player player)
        +void play(String pattern)
        +void pause()
        +void resume()
        +void stop()
        +void seek(int index)
        +long getTickPosition()
        +long getTickLength()
        +boolean isActive()
    }

    class ManagedPlayer {
        +void pause()
        +void resume()
        +void finish()
        +void reset()
        +void seek(long tick)
        +boolean isPlaying()
        +boolean isPaused()
    }

    class TtmException {
        -ErrorCode code
        +TtmException(ErrorCode code, String message)
        +TtmException(ErrorCode code, String message, Throwable cause)
        +ErrorCode getCode()
    }

    class ErrorCode {
        <<enumeration>>
        INVALID_INPUT
        INVALID_CHARACTER
        MUSIC_NOT_FOUND
        INVALID_PLAYBACK_CONFIG
        PERSISTENCE_FAILURE
        AUDIO_UNAVAILABLE
    }
